# Copy to .env for local dev
DATABASE_URL=postgresql+asyncpg://drs:drs@localhost:5432/drs
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-only-change-me-to-a-long-random-32plus-byte-string
JWT_ALG=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
ENV=dev
CORS_ORIGINS=http://localhost:3000

# DB pooling: 'direct' (dev) or 'pgbouncer' (prod behind transaction pooling)
DB_POOL_MODE=direct
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_SSL=false   # set true for managed Postgres in prod (requires TLS)

# MSG91 OTP SMS (set both authkey + template_id to actually send; template needs DLT approval)
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER=
MSG91_OTP_EXPIRY_MIN=5

# Razorpay (REQUIRED in prod — boot fails without them; empty = dev stub)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp (Gupshup BSP) — empty = dev stub (messages logged, not sent)
WHATSAPP_PROVIDER=gupshup
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE=
GUPSHUP_SRC_NAME=

# GST invoicing (seller identity)
SELLER_LEGAL_NAME=Dhanna Ram Sherawat Enterprises
SELLER_GSTIN=
SELLER_STATE=Rajasthan
INVOICE_PREFIX=DRS

# Observability / cache
SENTRY_DSN=
LOG_JSON=false
CACHE_TTL_SECONDS=300
WALLET_LOW_THRESHOLD=100
