# Copy to .env for local dev
DATABASE_URL=postgresql+asyncpg://drs:drs@localhost:5432/drs
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-only-change-me-to-a-long-random-32plus-byte-string
JWT_ALG=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
ENV=dev
CORS_ORIGINS=http://localhost:3000

# MSG91 OTP SMS (set both authkey + template_id to actually send; template needs DLT approval)
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER=
MSG91_OTP_EXPIRY_MIN=5
